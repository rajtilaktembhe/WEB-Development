                grid-template-columns: 1fr;
            }

            .swap {
                margin: auto;
            }
        }
    </style>
</head>

<body>

    <div class="converter">

        <div class="icon">⇄</div>

        <h1>Digital Unit Converter</h1>

        <p class="subtitle">
            Convert Length, Mass & Temperature instantly
        </p>

        <div class="group">
            <label class="label">Conversion Category</label>

            <select id="category" onchange="updateUnits()">
                <option value="length">📏 Length</option>
                <option value="mass">⚖️ Mass</option>
                <option value="temperature">🌡️ Temperature</option>
            </select>
        </div>

        <div class="group">
            <label class="label">Enter Value</label>

            <input
                type="number"
                id="value"
                placeholder="Enter a number"
            >
        </div>

        <div class="units">

            <div>
                <label class="label">From</label>

                <select id="fromUnit"></select>
            </div>

            <button class="swap" onclick="swapUnits()">⇄</button>

            <div>
                <label class="label">To</label>

                <select id="toUnit"></select>
            </div>

        </div>

        <button class="convert" onclick="convertUnit()">
            Convert Now
        </button>

        <div class="result">

            <div class="result-title">
                CONVERSION RESULT
            </div>

            <div class="result-value" id="result">
                —
            </div>

        </div>

        <div class="footer">
            Digital Unit Converter • Powered by Node.js & Express
        </div>

    </div>

    <script>

        const units = {

            length: [
                "Meter",
                "Kilometer",
                "Centimeter",
                "Millimeter",
                "Mile",
                "Foot",
                "Inch"
            ],

            mass: [
                "Gram",
                "Kilogram",
                "Milligram",
                "Tonne",
                "Pound",
                "Ounce"
            ],

            temperature: [
                "Celsius",
                "Fahrenheit",
                "Kelvin"
            ]

        };


        function updateUnits() {

            const category =
                document.getElementById("category").value;

            const from =
                document.getElementById("fromUnit");

            const to =
                document.getElementById("toUnit");

            from.innerHTML = "";
            to.innerHTML = "";

            units[category].forEach(unit => {

                const option1 =
                    document.createElement("option");

                option1.value = unit;
                option1.textContent = unit;

                const option2 =
                    document.createElement("option");

                option2.value = unit;
                option2.textContent = unit;

                from.appendChild(option1);
                to.appendChild(option2);

            });

            to.selectedIndex = 1;
        }


        function swapUnits() {

            const from =
                document.getElementById("fromUnit");

            const to =
                document.getElementById("toUnit");

            const temp = from.value;

            from.value = to.value;
            to.value = temp;

        }


        async function convertUnit() {

            const category =
                document.getElementById("category").value;

            const value =
                document.getElementById("value").value;

            const from =
                document.getElementById("fromUnit").value;

            const to =
                document.getElementById("toUnit").value;

            const result =
                document.getElementById("result");


            if (value === "") {

                result.textContent =
                    "Enter a value";

                return;

            }


            try {

                const response =
                    await fetch("/convert", {

                        method: "POST",

                        headers: {
                            "Content-Type": "application/json"
                        },

                        body: JSON.stringify({

                            category: category,

                            value: Number(value),

                            from: from,

                            to: to

                        })

                    });


                const data =
                    await response.json();


                if (!response.ok) {

                    result.textContent =
                        data.error;

                    return;

                }


                result.textContent =
                    data.result + " " + data.unit;


            } catch (error) {

                result.textContent =
                    "Server Error";

            }

        }


        updateUnits();

    </script>

</body>
</html>
    `);
});


app.post("/convert", (req, res) => {

    const {
        category,
        value,
        from,
        to
    } = req.body;


    if (value === undefined || isNaN(value)) {

        return res.status(400).json({
            error: "Invalid value"
        });

    }


    let result;


    if (category === "length") {

        const units = {

            Meter: 1,

            Kilometer: 1000,

            Centimeter: 0.01,

            Millimeter: 0.001,

            Mile: 1609.344,

            Foot: 0.3048,

            Inch: 0.0254

        };


        if (!units[from] || !units[to]) {

            return res.status(400).json({
                error: "Invalid unit"
            });

        }


        result =
            value * units[from] / units[to];

    }


    else if (category === "mass") {

        const units = {

            Gram: 1,

            Kilogram: 1000,

            Milligram: 0.001,

            Tonne: 1000000,

            Pound: 453.59237,

            Ounce: 28.349523125

        };


        if (!units[from] || !units[to]) {

            return res.status(400).json({
                error: "Invalid unit"
            });

        }


        result =
            value * units[from] / units[to];

    }


    else if (category === "temperature") {

        let celsius;


        if (from === "Celsius") {

            celsius = value;

        }

        else if (from === "Fahrenheit") {

            celsius =
                (value - 32) * 5 / 9;

        }

        else if (from === "Kelvin") {

            celsius =
                value - 273.15;

        }


        if (to === "Celsius") {

            result = celsius;

        }

        else if (to === "Fahrenheit") {

            result =
                celsius * 9 / 5 + 32;

        }

        else if (to === "Kelvin") {

            result =
                celsius + 273.15;

        }

        else {

            return res.status(400).json({
                error: "Invalid temperature unit"
            });

        }

    }


    else {

        return res.status(400).json({
            error: "Invalid category"
        });

    }


    res.json({

        result: Number(result.toFixed(2)),

        unit: to

    });

});


app.listen(PORT, () => {

    console.log(
        "Server running at http://localhost:" + PORT
    );

});
