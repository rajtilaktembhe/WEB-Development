            border: 1px solid rgba(255,255,255,0.12);
        }

        .result-title {
            font-size: 13px;
            color: #94a3b8;
            margin-bottom: 7px;
        }

        .result-value {
            font-size: 27px;
            font-weight: bold;
            color: #67e8f9;
