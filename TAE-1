            cursor: pointer;
            box-shadow: 0 10px 25px rgba(6,182,212,0.25);
            transition: 0.3s;
        }

        .convert:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 30px rgba(6,182,212,0.35);
