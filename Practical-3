<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SB Jain Technical Festival 2026</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gradient-to-r from-slate-900 via-teal-800 to-cyan-700">

    <div class="max-w-5xl mx-auto my-10 bg-white rounded-2xl shadow-2xl overflow-hidden">

        <!-- Header -->
        <div class="bg-emerald-700 text-white text-center py-10 px-6">
            <h2 class="text-xl font-medium uppercase tracking-widest">
                SB Jain Institute of Technology, Management & Research
            </h2>

            <h1 class="text-5xl font-bold mt-3">
                TECHNICAL FESTIVAL 2026
            </h1>

            <p class="text-lg mt-3">
                Learn • Innovate • Compete • Achieve
            </p>
        </div>

        <!-- Content -->
        <div class="p-10">

            <h2 class="text-3xl font-bold text-center text-emerald-700">
                Welcome to Our Annual Technical Festival!
            </h2>

            <p class="text-gray-700 text-lg text-center mt-5 leading-8">
                SB Jain Institute of Technology, Management & Research,
                Nagpur proudly invites students, faculty members,
                alumni, and technology enthusiasts to participate in the
                <b>Technical Festival 2026</b>. Join us for an exciting day
                filled with innovation, creativity, learning opportunities,
                and competitive technical events.
            </p>

            <!-- Highlights -->
            <div class="mt-10">

                <h3 class="text-2xl font-bold text-emerald-700 text-center mb-6">
                    Festival Highlights
                </h3>

                <div class="grid md:grid-cols-2 gap-5">

                    <div class="bg-cyan-50 border-l-4 border-cyan-600 p-4 rounded-lg shadow">
                        💻 Coding Contest & Hackathon
                    </div>

                    <div class="bg-cyan-50 border-l-4 border-cyan-600 p-4 rounded-lg shadow">
                        🤖 Robotics Challenge
                    </div>

                    <div class="bg-cyan-50 border-l-4 border-cyan-600 p-4 rounded-lg shadow">
                        🧠 Artificial Intelligence Workshop
                    </div>

                    <div class="bg-cyan-50 border-l-4 border-cyan-600 p-4 rounded-lg shadow">
                        🚀 Innovative Project Exhibition
                    </div>

                    <div class="bg-cyan-50 border-l-4 border-cyan-600 p-4 rounded-lg shadow">
                        🎮 E-Sports & Gaming Tournament
                    </div>

                    <div class="bg-cyan-50 border-l-4 border-cyan-600 p-4 rounded-lg shadow">
                        🏆 Technical Quiz with Exciting Rewards
                    </div>

                </div>

            </div>

            <!-- Event Details -->

            <div class="mt-10 bg-gray-100 rounded-xl p-8 shadow-lg border">

                <h3 class="text-2xl font-bold text-center text-green-700 mb-6">
                    Event Details
                </h3>

                <div class="grid md:grid-cols-2 gap-6 text-lg">

                    <div>
                        <p><strong>📅 Date:</strong> 20 September 2026</p>

                        <p class="mt-3">
                            <strong>⏰ Time:</strong> 11:00 AM Onwards
                        </p>
                    </div>

                    <div>
                        <p><strong>📍 Venue:</strong></p>

                        <p>
                            SB Jain Institute of Technology,
                            Management & Research, Nagpur
                        </p>
                    </div>

                </div>

            </div>

            <!-- Why Attend -->

            <div class="mt-10 text-center">

                <h3 class="text-2xl font-bold text-emerald-700">
                    Why Should You Join?
                </h3>

                <p class="mt-4 text-gray-700 leading-8">
                    Experience the latest technological innovations,
                    collaborate with talented participants,
                    attend expert-led workshops, demonstrate your skills,
                    build professional connections, and earn certificates
                    along with exciting prizes.
                </p>

            </div>

            <!-- Buttons -->

            <div class="mt-10 flex justify-center gap-5">

                <button class="bg-emerald-700 hover:bg-emerald-800 text-white px-8 py-3 rounded-lg font-semibold shadow-lg transition">
                    Register Now
                </button>

                <button class="bg-orange-500 hover:bg-orange-600 text-white px-8 py-3 rounded-lg font-semibold shadow-lg transition">
                    Contact Us
                </button>

            </div>

        </div>

        <!-- Footer -->

        <div class="bg-emerald-700 text-white text-center py-5">

            <p class="font-semibold">
                We Look Forward to Welcoming Students, Faculty Members & Guests
            </p>

            <p class="text-sm mt-2">
                © 2026 SB Jain Institute of Technology, Management & Research, Nagpur
            </p>

        </div>

    </div>

</body>
</html>
